# Copy to /opt/revontulet-alerts/alerts.env and fill in. Never commit the real file.

# APNs token auth (.p8 key converted to PEM, mounted as the apns_key Docker secret)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_PATH=/run/secrets/apns_key
APNS_TOPIC=fi.juusimaa.revontulet
# production for TestFlight and App Store builds; sandbox for a development instance
APNS_ENVIRONMENT=production

# Heartbeat monitor pinged after every evaluation cycle
HEALTHCHECK_PING_URL=

DATABASE_PATH=/data/alerts.db
