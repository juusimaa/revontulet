<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the generated Info.plist. The alert service's base URL, from ALERTS_BASE_URL in project.yml. -->
	<key>AlertsBaseURL</key>
	<string>$(ALERTS_BASE_URL)</string>
	<!-- Debug builds talk to a development alert service on localhost over plain HTTP. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
