    "NSLocationWhenInUseUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your location is used only on this device to find the nearest measurement station and your municipality. It is never sent anywhere."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sijaintiasi käytetään vain tällä laitteella lähimmän mittausaseman ja kuntasi selvittämiseen. Sitä ei lähetetä minnekään."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din plats används endast på den här enheten för att hitta närmaste mätstation och din kommun. Den skickas aldrig någonstans."
          }
        }
      }
    }
