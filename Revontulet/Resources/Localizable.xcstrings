    "Alerts are for an area of Finland. Allow location access or choose a municipality, and the area is set from it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alerts are for an area of Finland. Allow location access or choose a municipality, and the area is set from it."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hälytykset koskevat aluetta Suomessa. Salli sijainti tai valitse kunta, niin alue määräytyy sen mukaan."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aviseringar gäller ett område i Finland. Tillåt platstjänster eller välj en kommun så bestäms området utifrån den."
          }
        }
      }
    },
    "Alerts are on": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
