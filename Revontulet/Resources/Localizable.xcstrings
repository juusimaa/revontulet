    "Aurora data from FMI is needed to show a chance. Connect to the internet and try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aurora data from FMI is needed to show a chance. Connect to the internet and try again."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Todennäköisyyden näyttämiseen tarvitaan Ilmatieteen laitoksen revontulitietoja. Yhdistä verkkoon ja yritä uudelleen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Norrskensdata från Meteorologiska institutet behövs för att visa en chans. Anslut till internet och försök igen."
          }
        }
      }
    },
    "Based on NOAA's Kp forecast and storm watches, FMI's cloud forecast for your area, and the sun and moon where you are.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Based on NOAA's Kp forecast and storm watches, FMI's cloud forecast for your area, and the sun and moon where you are."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Perustuu NOAA:n Kp-ennusteeseen ja myrskyvaroituksiin, Ilmatieteen laitoksen pilviennusteeseen alueellesi sekä auringon ja kuun asemaan sijainnissasi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bygger på NOAA:s Kp-prognos och stormvarningar, Meteorologiska institutets molnprognos för ditt område samt solen och månen där du är."
          }
        }
      }
    },
